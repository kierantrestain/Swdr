# Private, server-side variables for the hosted team workspace (/api/team).
# Never prefix them with VITE_: anything prefixed VITE_ is compiled into the public bundle.

# Required. PostgreSQL connection string for the application. Apply server/team-schema.sql first.
SWDR_TEAM_DATABASE_URL=

# Optional. Who may create an account:
#   invite (default) - only someone holding a valid invitation link
#   open             - anyone; they see only projects they own or were invited to
# Any other value disables the workspace (fails closed).
SWDR_TEAM_SIGNUP=invite

# Optional, legacy. Operator-provisioned access keys: a JSON object mapping each email to the
# SHA-256 hex digest of its 32-byte access key. Leave empty when everyone uses a password account.
SWDR_TEAM_ACCOUNTS=
