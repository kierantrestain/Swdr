# Private, server-side variables for the hosted team workspace (/api/team).
# Never prefix them with VITE_: anything prefixed VITE_ is compiled into the public bundle.

# Required. PostgreSQL connection string for the application. Apply server/team-schema.sql first.
SWDR_TEAM_DATABASE_URL=

# Optional. Who may create an account:
#   invite (default) - only someone holding a valid invitation link
#   open             - anyone; they see only projects they own or were invited to
# Any other value disables the workspace (fails closed).
SWDR_TEAM_SIGNUP=invite

# Optional, legacy. Operator-provisioned access keys: a JSON object mapping each email to the
# SHA-256 hex digest of its 32-byte access key. Leave empty when everyone uses a password account.
SWDR_TEAM_ACCOUNTS=

# Optional. AI partner providers: set any key and the provider's models appear in the picker. See docs/ai.md.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
# Your own (for example fine-tuned) model on any OpenAI-compatible server.
SWDR_AI_CUSTOM_BASE_URL=
SWDR_AI_CUSTOM_API_KEY=
SWDR_AI_CUSTOM_LABEL=
# provider:model, such as anthropic:claude-opus-5-5. Requests per account per day (default 60).
SWDR_AI_DEFAULT_MODEL=
SWDR_AI_DAILY_LIMIT=

# Optional. Lifetime Pro upgrade through Stripe Checkout (see docs/plans.md). Without a secret key, everyone has Pro limits.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SWDR_PRO_PRICE_PENCE=9900
SWDR_AI_PRO_LIMIT=150

# Optional. Password reset emails through Resend (verify your domain first).
RESEND_API_KEY=
RESEND_FROM=SWDR <noreply@yourdomain.com>
